# 复制为 deploy/.env 后填写。deploy/.env 已被 gitignore，不得提交。

# Dify 应用的 API 密钥（应用 →「访问 API」→ 创建密钥，形如 app-...）
DIFY_APP_KEY=

# 平台只发布在本机的这个端口
DIFY_PORT=8080
DIFY_BASE=http://127.0.0.1:8080/v1

# 你上传到知识库的那批文件所在目录（原件放 testkit/private/ 下，不提交）。文件一变，被测系统指纹就变。
DAXIN_KB_DIR=

# 对这一版被测系统的说明，计入指纹。改了 Dify 里的提示词、模型或检索设置后，必须同时改这里。
DAXIN_SYSTEM_LABEL=kb-v1 默认配置

# 答信工作区（默认 deploy/data/ws）
# DAXIN_WS=

# 记录操作者
DAXIN_USER=

# 审计链 HMAC 密钥（可选；自己生成一段随机字符串，丢失后旧链无法校验，请另行保管）
# DAXIN_AUDIT_KEY=
